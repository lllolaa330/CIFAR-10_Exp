{
  "schema_version": 1,
  "experiment": "resnet18_ablation",
  "variant": "w32_noaug_drop03",
  "display_name": "+ Dropout + Width32",
  "seed": 266978,
  "model": {
    "name": "ResNet18",
    "num_classes": 10,
    "base_channels": 32,
    "dropout": 0.3,
    "zero_init_residual": false
  },
  "data": {
    "data_dir": "data/cifar-10-batches-py",
    "val_ratio": 0.1,
    "num_workers": 0,
    "download": true,
    "augmentation": {
      "random_crop_padding": 0,
      "horizontal_flip": false
    }
  },
  "training": {
    "epochs": 200,
    "batch_size": 128,
    "criterion": {
      "name": "CrossEntropyLoss",
      "label_smoothing": 0.0
    },
    "optimizer": {
      "name": "SGD",
      "lr": 0.1,
      "momentum": 0.9,
      "weight_decay": 0.0005,
      "nesterov": false
    },
    "scheduler": {
      "name": "CosineAnnealingLR",
      "eta_min": 0.0
    },
    "checkpoint_every": 1,
    "evaluate_test": true
  },
  "runtime": {
    "device": "auto",
    "deterministic": false
  },
  "output": {
    "runs_dir": "runs"
  }
}
